# Installed by tools/imu_rb3.py --install: RB3 Gen 2 onboard IMU streaming (robot/jero-imu-setup.sh).
[Unit]
Description=Jero: stream the RB3 onboard IMU (IIO buffers) for the walk
After=systemd-udev-settle.service
Before=jero-walk.service jero-demo.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/jero-imu-setup

[Install]
WantedBy=multi-user.target
