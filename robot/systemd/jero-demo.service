# Installed by robot/freeze_demo.sh --autostart (placeholders @USER@ / @HOME@ / @REPO@ / @VENV@ are
# substituted). At boot: robot/jero.sh waits for the PS4 pad (as long as it takes), finds the Pico,
# starts the walk paused (Cross starts it). If the walk ever exits, it is started again.
[Unit]
Description=Jero demo (robot/jero.sh: PS4 pad + walk, starts paused)
After=bluetooth.target jero-bt-connectable.service
Wants=bluetooth.target
Conflicts=jero-walk.service open-duck-walk.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
Environment=PYTHONUNBUFFERED=1
Environment=JERO_PAD_WAIT_S=0
Environment=VENV=@VENV@
Environment=JERO_RUNTIME_DIR=@HOME@/Open_Duck_Mini_Runtime
ExecStart=@REPO@/robot/jero.sh
Restart=always
RestartSec=5
# SIGINT lets RLWalk run its KeyboardInterrupt cleanup.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
