 · emote · look&#10;(timeline from executor)" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#5A9A4F;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="830" y="210" width="220" height="80" as="geometry"/></mxCell><mxCell id="pause" value="Paused&#10;RLWalk.paused&#10;servos hold" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="300" width="200" height="90" as="geometry"/></mxCell><mxCell id="fall" value="Fallen&#10;tilt &gt; threshold (TBD)&#10;torque → low" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="830" y="650" width="220" height="80" as="geometry"/></mxCell><mxCell id="_auto11" value="service starts" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="boot" target="init"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="_auto12" value="ready" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="init" target="stand"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="_auto13" value="command ≠ 0" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stand" target="walk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="_auto14" value="command = 0&#10;or link stale (TTL)" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="walk" target="stand"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="_auto15" value="skill starts" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="stand" target="skill"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="_auto16" value="done · cancel · &quot;stop&quot;" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="skill" target="stand"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="_auto17" value="A · link e-stop&#10;low battery (new)" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="pause"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="_auto18" value="tilt &gt; threshold (new)" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="fall"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="_auto19" value="auto" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fall" target="pause"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="690"/></Array></mxGeometry></mxCell><mxCell id="_auto20" value="A (resume)&#10;operator has set Jero upright" style="html=0;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pause" target="stand"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="110"/><mxPoint x="640" y="110"/></Array></mxGeometry></mxCell><mxCell id="_auto21" value="Rules&#10;• Gamepad input always wins over the link, in every mode.&#10;• Link lost: commands decay to zero within the TTL, so Walking → Standing on its own.&#10;• Skills only start from Standing; the executor waits for 'standing' in telemetry.&#10;• Policy switching (stand / dance policies, later) happens only in Standing." style="text;html=0;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>